<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>io.github.gmelan</groupId><artifactId>memoharbor</artifactId><version>1.3.0</version><packaging>war</packaging>
  <name>MemoHarbor</name><description>Independent Servlet webapp (Jakarta: WildFly 27+, Tomcat 10.1/11; javax via -Ptomcat9: Tomcat 9) for an APM testbed</description>
  <properties><maven.compiler.release>17</maven.compiler.release><project.build.sourceEncoding>UTF-8</project.build.sourceEncoding><project.build.outputTimestamp>2026-10-05T00:00:00Z</project.build.outputTimestamp><memoharbor.sourceDirectory>src/main/java</memoharbor.sourceDirectory><memoharbor.warSourceDirectory>src/main/webapp</memoharbor.warSourceDirectory></properties>
  <dependencies>
    <dependency><groupId>org.mariadb.jdbc</groupId><artifactId>mariadb-java-client</artifactId><version>3.5.10</version></dependency>
    <dependency><groupId>org.xerial</groupId><artifactId>sqlite-jdbc</artifactId><version>3.51.1.1</version></dependency>
    <dependency><groupId>org.slf4j</groupId><artifactId>slf4j-api</artifactId><version>1.7.36</version></dependency>
    <dependency><groupId>org.slf4j</groupId><artifactId>slf4j-jdk14</artifactId><version>1.7.36</version></dependency>
    <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><version>5.11.4</version><scope>test</scope></dependency>
  </dependencies>
  <build>
    <finalName>memoharbor</finalName>
    <sourceDirectory>${memoharbor.sourceDirectory}</sourceDirectory>
    <plugins>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId><version>3.13.0</version></plugin>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId><version>3.5.2</version></plugin>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-war-plugin</artifactId><version>3.4.0</version><configuration><warSourceDirectory>${memoharbor.warSourceDirectory}</warSourceDirectory><failOnMissingWebXml>false</failOnMissingWebXml><packagingExcludes>**/.env,**/.env.*,**/*.sqlite,**/*.sqlite-*</packagingExcludes></configuration></plugin>
    </plugins>
  </build>
  <profiles>
    <!-- Default: Jakarta Servlet 6 (WildFly 27+, Tomcat 10.1/11). -->
    <profile>
      <id>jakarta</id>
      <activation><activeByDefault>true</activeByDefault></activation>
      <dependencies>
        <dependency><groupId>jakarta.servlet</groupId><artifactId>jakarta.servlet-api</artifactId><version>6.0.0</version><scope>provided</scope></dependency>
        <dependency><groupId>org.apache.tomcat.embed</groupId><artifactId>tomcat-embed-core</artifactId><version>11.0.27</version><scope>test</scope></dependency>
      </dependencies>
    </profile>
    <!-- mvn -Ptomcat9 verify: javax Servlet 4.0 WAR for Tomcat 9, built from the same sources into target/tomcat9/memoharbor.war. -->
    <profile>
      <id>tomcat9</id>
      <properties>
        <maven.compiler.release>11</maven.compiler.release>
        <memoharbor.sourceDirectory>${project.build.directory}/javax/java</memoharbor.sourceDirectory>
        <memoharbor.warSourceDirectory>${project.build.directory}/javax/webapp</memoharbor.warSourceDirectory>
      </properties>
      <dependencies>
        <dependency><groupId>javax.servlet</groupId><artifactId>javax.servlet-api</artifactId><version>4.0.1</version><scope>provided</scope></dependency>
        <dependency><groupId>org.apache.tomcat.embed</groupId><artifactId>tomcat-embed-core</artifactId><version>9.0.123</version><scope>test</scope></dependency>
      </dependencies>
      <build>
        <directory>${project.basedir}/target/tomcat9</directory>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId><artifactId>maven-antrun-plugin</artifactId><version>3.1.0</version>
            <executions>
              <execution>
                <id>jakarta-to-javax</id><phase>generate-sources</phase><goals><goal>run</goal></goals>
                <configuration>
                  <target>
                    <delete dir="${project.build.directory}/javax"/>
                    <copy todir="${project.build.directory}/javax/java" encoding="UTF-8">
                      <fileset dir="${project.basedir}/src/main/java"/>
                      <filterchain><tokenfilter><replaceregex pattern="\bjakarta\.servlet\." replace="javax.servlet." flags="g"/></tokenfilter></filterchain>
                    </copy>
                    <copy todir="${project.build.directory}/javax/webapp"><fileset dir="${project.basedir}/src/main/webapp" excludes="WEB-INF/web.xml"/></copy>
                    <copy file="${project.basedir}/src/main/webapp/WEB-INF/web.xml" todir="${project.build.directory}/javax/webapp/WEB-INF" encoding="UTF-8">
                      <filterchain><tokenfilter><replacestring from="xmlns=&quot;https://jakarta.ee/xml/ns/jakartaee&quot; version=&quot;6.0&quot;" to="xmlns=&quot;http://xmlns.jcp.org/xml/ns/javaee&quot; version=&quot;4.0&quot;"/></tokenfilter></filterchain>
                    </copy>
                    <fail message="jakarta.* reference left in javax sources">
                      <condition><resourcecount when="greater" count="0"><fileset dir="${project.build.directory}/javax" includes="**/*.java,**/*.xml"><containsregexp expression="jakarta"/></fileset></resourcecount></condition>
                    </fail>
                  </target>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
